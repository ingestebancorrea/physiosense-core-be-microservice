# LOCAL (Supabase -> Project Settings -> Database -> Connection string)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/physiosense_core

# LAB (session pooler IPv4)
#DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres

PORT=3001

# Debe ser EXACTAMENTE el mismo secreto que usa authentication-be-microservice:
# este servicio verifica los tokens que ese microservicio emite.
JWT_SECRET=cambia-este-secreto-por-el-mismo-del-servicio-de-autenticacion

# Secreto compartido con authentication-be-microservice para los endpoints de
# sincronizacion (POST /patients/sync y POST /therapists/sync).
#
# Esos endpoints NO pueden usar ActorGuard: el guard resuelve el rol contra las
# tablas de este servicio, asi que un usuario recien registrado todavia no tiene
# perfil aca y nunca podria crearse. Se autentican con este secreto en el header
# `x-internal-sync-secret`.
INTERNAL_SYNC_SECRET=cambia-este-secreto-por-el-compartido-con-el-servicio-de-autenticacion

# Opcional: URL publica del microservicio de autenticacion, para resolver el
# perfil del usuario cuando el token no trae el rol.
AUTH_SERVICE_URL=https://authentication-be-microservice-lab.onrender.com/api/v1

# Logger SQL de TypeORM
#DB_LOGGING=false

# TLS hacia Postgres (obligatorio en Supabase / Neon)
#DB_SSL=true

# Limites de media para ejercicios (coinciden con MEDIA_LIMITS del cliente movil)
MEDIA_VIDEO_MAX_BYTES=104857600
MEDIA_IMAGE_MAX_BYTES=5242880

# Carpeta donde se guardan los videos e imagenes subidos por los fisioterapeutas
MEDIA_STORAGE_PATH=./storage/media