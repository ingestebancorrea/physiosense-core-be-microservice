# LOCAL (Postgres local: physiosense_core_db es el NOMBRE DE LA BASE DE DATOS)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/physiosense_core_db

# LAB (Supabase). OJO: en Supabase la base SIEMPRE se llama `postgres`; el
# schema se indica aparte con DB_SCHEMA (TypeORM ignora ?schema= en la URL).
#DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres
#DB_SCHEMA=physiosense_core_db

PORT=3001

# Debe ser EXACTAMENTE el mismo secreto que usa authentication-be-microservice:
# este servicio verifica los tokens que ese microservicio emite, y AuthClient
# firma con el suyo el token de servicio con el que llama a los endpoints de
# ese servicio (GET /users/:id/profile, GET /patients, GET /physiotherapists).
JWT_SECRET=cambia-este-secreto-por-el-mismo-del-servicio-de-autenticacion

# URL publica del microservicio de autenticacion, con el prefijo /api/v1.
# OBLIGATORIA: ahi viven patients, physiotherapists y los roles, y este servicio
# ya no tiene copia local de esas tablas. Sin ella, cualquier operacion que
# necesite identidad (ActorGuard, listados, fichas) responde 503.
AUTH_SERVICE_URL=https://authentication-be-microservice-lab.onrender.com/api/v1

# Logger SQL de TypeORM
#DB_LOGGING=false

# TLS hacia Postgres (obligatorio en Supabase / Neon)
#DB_SSL=true

# Limites de media para ejercicios (coinciden con MEDIA_LIMITS del cliente movil)
MEDIA_VIDEO_MAX_BYTES=104857600
MEDIA_IMAGE_MAX_BYTES=5282600

# Carpeta donde se guardan los videos e imagenes subidos por los fisioterapeutas
MEDIA_STORAGE_PATH=./storage/media
